{
  "name": "witcherscript-redkit-tools",
  "displayName": "WitcherScript REDkit Tools",
  "description": "VS Code client for the WitcherScript language server and REDkit project tooling.",
  "version": "0.4.0",
  "publisher": "witcherscript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bi3lu/witcherscript-redkit-tools.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:witcherscript",
    "onCommand:witcherscript.refreshIndex",
    "onCommand:witcherscript.redkitInit",
    "onCommand:witcherscript.redkitRecompile",
    "onCommand:witcherscript.redkitLaunchGame",
    "onCommand:witcherscript.restartLanguageServer",
    "onCommand:witcherscript.showOutput"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "lint": "eslint src",
    "smoke": "npm run lint && npm run check && npm run compile",
    "package:vsix": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "witcherscript",
        "aliases": [
          "WitcherScript",
          "witcherscript"
        ],
        "extensions": [
          ".ws"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "event",
        "description": "WitcherScript event declaration or reference."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "native",
        "description": "Native WitcherScript symbol."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "witcherscript",
        "scopes": {
          "event": [
            "entity.name.function.event.witcherscript"
          ],
          "*.native": [
            "support.function.native.witcherscript",
            "support.type.native.witcherscript"
          ],
          "*.deprecated": [
            "invalid.deprecated.witcherscript"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[witcherscript]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "witcherscript.refreshIndex",
        "title": "WitcherScript: Refresh Project Index"
      },
      {
        "command": "witcherscript.redkitInit",
        "title": "WitcherScript: Initialize REDkit Config"
      },
      {
        "command": "witcherscript.redkitRecompile",
        "title": "WitcherScript: Recompile Scripts"
      },
      {
        "command": "witcherscript.redkitLaunchGame",
        "title": "WitcherScript: Launch Game"
      },
      {
        "command": "witcherscript.restartLanguageServer",
        "title": "WitcherScript: Restart Language Server"
      },
      {
        "command": "witcherscript.showOutput",
        "title": "WitcherScript: Show Output Logs"
      }
    ],
    "configuration": {
      "title": "WitcherScript REDkit Tools",
      "properties": {
        "witcherscript.workspace.root": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Workspace root URI/path used by the language client. Supports ${workspaceFolder} and ${extensionPath}."
        },
        "witcherscript.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Optional executable path used instead of witcherscript.languageServer.command. Leave empty to use the command setting."
        },
        "witcherscript.languageServer.command": {
          "type": "string",
          "default": "uv",
          "description": "Command used to start the WitcherScript language server when languageServer.path is empty."
        },
        "witcherscript.languageServer.args": {
          "type": "array",
          "default": [
            "run",
            "witcherscript-lsp"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the WitcherScript language server command."
        },
        "witcherscript.languageServer.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory used when starting the language server. Leave empty to use the bundled server in packaged builds or the repository root during extension development."
        },
        "witcherscript.redkit.command": {
          "type": "string",
          "default": "dotnet",
          "description": "Command used to run the REDkit tooling CLI."
        },
        "witcherscript.redkit.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments placed before the REDkit CLI command. When empty, the extension runs the repository-local C# CLI project."
        },
        "witcherscript.redkit.recompile.executable": {
          "type": "string",
          "default": "",
          "description": "Executable used by ws-redkit recompile. Supports ${workspaceFolder} and ${extensionPath}."
        },
        "witcherscript.redkit.launch.executable": {
          "type": "string",
          "default": "",
          "description": "Optional game executable used by ws-redkit launch-game. Leave empty to let the CLI resolve it from witcherscript.toml."
        },
        "witcherscript.redkit.launch.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed through to the game executable by ws-redkit launch-game."
        }
      }
    }
  }
}
